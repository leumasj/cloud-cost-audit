    "@vercel/speed-insights": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.16.0",
    "stripe": "^14.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
