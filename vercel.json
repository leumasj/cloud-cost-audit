{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/terms/",
      "dest": "/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/privacy/",
      "dest": "/privacy.html"
    },
    {
      "src": "/widget",
      "dest": "/widget.html"
    },
    {
      "src": "/widget/",
      "dest": "/widget.html"
    },
    {
      "src": "/82bbc970601d4829ad6c8bc50f3506a7.txt",
      "dest": "/82bbc970601d4829ad6c8bc50f3506a7.txt"
    },
    {
      "src": "/blog/(.*)/",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/blog/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/infrastructure-cost-reduction",
      "destination": "/cloud-finops-guide/",
      "permanent": true
    },
    {
      "source": "/infrastructure-cost-reduction/",
      "destination": "/cloud-finops-guide/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kloudaudit.eu"
        }
      ],
      "destination": "https://www.kloudaudit.eu/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "getkloudaudit.com"
        }
      ],
      "destination": "https://www.kloudaudit.eu/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.getkloudaudit.com"
        }
      ],
      "destination": "https://www.kloudaudit.eu/$1",
      "permanent": true
    }
  ]
}