{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/terms/",
      "dest": "/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/privacy/",
      "dest": "/privacy.html"
    },
    {
      "src": "/widget",
      "dest": "/widget.html"
    },
    {
      "src": "/widget/",
      "dest": "/widget.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 10
    },
    "api/process-pending.js": {
      "maxDuration": 60
    },
    "api/create-checkout.js": {
      "maxDuration": 10
    },
    "api/save-audit.js": {
      "maxDuration": 10
    },
    "api/ai-preview.js": {
      "maxDuration": 30
    },
    "api/send-report.js": {
      "maxDuration": 10
    },
    "api/send-reaudit.js": {
      "maxDuration": 60
    },
    "api/get-benchmarks.js": {
      "maxDuration": 10
    },
    "api/dashboard.js": {
      "maxDuration": 10
    },
    "api/unsubscribe.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    }
  }
}